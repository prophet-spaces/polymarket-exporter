{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "uid": "polymarket-wallet-overview",
  "title": "Polymarket Wallet Overview",
  "tags": ["polymarket", "wallet"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "" },
        "definition": "label_values(up{job=\"polymarket-wallet\"}, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "Wallet",
        "multi": false,
        "name": "wallet",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"polymarket-wallet\"}, instance)"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "title": "Wallet Position Value",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [{
        "expr": "sum(polymarket_wallet_position_current_value_usdc{instance=~\"$wallet\"})",
        "refId": "A"
      }]
    },
    {
      "title": "Wallet Cash P&L Change (Selected Range)",
      "description": "Change in combined reported cash P&L over the selected dashboard time range.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [{
        "expr": "sum(polymarket_wallet_position_cash_pnl_usdc{instance=~\"$wallet\"}) - sum(polymarket_wallet_position_cash_pnl_usdc{instance=~\"$wallet\"} offset $__range)",
        "instant": true,
        "refId": "A"
      }]
    },
    {
      "title": "Wallet All-Time Realized P&L",
      "description": "All-time realized P&L reported by Polymarket, including closed position history from before this exporter started scraping.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [{
        "expr": "polymarket_wallet_all_time_realized_pnl_usdc{instance=~\"$wallet\"}",
        "instant": true,
        "refId": "A"
      }]
    },
    {
      "title": "Wallet Position Realized P&L",
      "description": "Combined realized P&L across positions currently returned by Polymarket.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [{
        "expr": "sum(polymarket_wallet_position_realized_pnl_usdc{instance=~\"$wallet\"})",
        "instant": true,
        "refId": "A"
      }]
    },
    {
      "title": "Wallet Position Prices",
      "type": "timeseries",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [{
        "expr": "polymarket_wallet_position_current_price{instance=~\"$wallet\"}",
        "legendFormat": "{{ question }} — {{ outcome }}",
        "refId": "A"
      }]
    },
    {
      "title": "Wallet Positions",
      "description": "Every open position for the selected wallet. Unrealized gain is current value minus traded amount.",
      "type": "table",
      "gridPos": { "h": 38, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Avg Price" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Now Price" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Traded" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "To Win" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Unrealized Gain" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Gain %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] } },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }],
        "footer": { "show": false }
      },
      "targets": [{
        "expr": "{__name__=~\"polymarket_wallet_position_(average_price|current_price|traded_usdc|payout_if_win_usdc|current_value_usdc|unrealized_gain_usdc|unrealized_gain_ratio)\", instance=~\"$wallet\"}",
        "refId": "A",
        "instant": true
      }],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "valueLabel": "__name__" }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "condition_id": true,
              "instance": true,
              "job": true,
              "token_id": true,
              "wallet": true
            },
            "indexByName": {
              "question": 0,
              "outcome": 1,
              "polymarket_wallet_position_average_price": 2,
              "polymarket_wallet_position_current_price": 3,
              "polymarket_wallet_position_traded_usdc": 4,
              "polymarket_wallet_position_current_value_usdc": 5,
              "polymarket_wallet_position_payout_if_win_usdc": 6,
              "polymarket_wallet_position_unrealized_gain_usdc": 7,
              "polymarket_wallet_position_unrealized_gain_ratio": 8
            },
            "renameByName": {
              "question": "Market",
              "outcome": "Outcome",
              "polymarket_wallet_position_average_price": "Avg Price",
              "polymarket_wallet_position_current_price": "Now Price",
              "polymarket_wallet_position_traded_usdc": "Traded",
              "polymarket_wallet_position_payout_if_win_usdc": "To Win",
              "polymarket_wallet_position_current_value_usdc": "Value",
              "polymarket_wallet_position_unrealized_gain_usdc": "Unrealized Gain",
              "polymarket_wallet_position_unrealized_gain_ratio": "Gain %"
            }
          }
        }
      ]
    }
  ],
  "version": 13
}

{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "uid": "polymarket-market-overview",
  "title": "Polymarket Market Overview",
  "tags": ["polymarket", "market"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
            {
                "current": {},
        "datasource": { "type": "prometheus", "uid": "" },
        "definition": "label_values(polymarket_market_last_trade_price, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(polymarket_market_last_trade_price, instance)"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "" },
        "definition": "label_values(polymarket_market_last_trade_price{instance=~\"$instance\"}, outcome)",
        "hide": 2,
        "includeAll": true,
        "label": "Outcome",
        "multi": true,
        "name": "outcome",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(polymarket_market_last_trade_price{instance=~\"$instance\"}, outcome)"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 2,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "title": "Market Last Trade Price",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "polymarket_market_last_trade_price{instance=~\"$instance\"}",
          "legendFormat": "{{ question }} — {{ outcome }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Market $outcome Bid / Ask",
      "description": "Spread bid and ask for $outcome outcome",
      "type": "timeseries",
      "repeat": "outcome",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": true
          },
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^bid" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^ask" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "polymarket_market_spread_bid{instance=~\"$instance\", outcome=\"$outcome\"}",
          "legendFormat": "bid",
          "refId": "A"
        },
        {
          "expr": "polymarket_market_spread_ask{instance=~\"$instance\", outcome=\"$outcome\"}",
          "legendFormat": "ask",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Market Spread",
      "description": "Bid-ask spread (ask - bid). Lower is tighter liquidity.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30,
            "spanNulls": true
          },
          "unit": "short",
          "min": 0,
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "polymarket_market_spread{instance=~\"$instance\"}",
          "legendFormat": "{{ question }} — {{ outcome }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Market Price Delta (15m)",
      "description": "Price change over 15 minutes using delta(), which is appropriate for gauge metrics.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.15 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "delta(polymarket_market_last_trade_price{instance=~\"$instance\"}[15m])",
          "legendFormat": "{{ question }} — {{ outcome }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Market Open Interest",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500000 },
              { "color": "red", "value": 2000000 }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "polymarket_market_open_interest{instance=~\"$instance\"}",
          "legendFormat": "{{ question }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Market $outcome Fee Rate",
      "type": "stat",
      "repeat": "outcome",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 200 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "polymarket_market_fee_rate_bps{instance=~\"$instance\", outcome=\"$outcome\"}",
          "legendFormat": "{{ outcome }}",
          "refId": "A"
        }
      ]
    },
        {
            "title": "Market $outcome Holders",
      "type": "table",
      "repeat": "outcome",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 200000 }
            ]
          },
          "unit": "short",
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Shares" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Shares", "desc": true }],
        "footer": { "show": false }
      },
      "targets": [
        {
          "expr": "polymarket_market_top_holder_amount{instance=~\"$instance\", outcome=\"$outcome\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "job": true,
              "token_id": true,
              "condition_id": true,
              "question": true,
              "outcome": true
            },
            "indexByName": {
              "instance": 0,
              "holder_rank": 1,
              "holder_name": 2,
              "Value": 3
            },
            "renameByName": {
              "instance": "Instance",
              "holder_rank": "Rank",
              "holder_name": "Holder",
              "Value": "Shares"
            }
          }
        }
      ]
    }
  ],
  "version": 4
}

[server]
listen_addr = "0.0.0.0:9184"

[cache]
holders_ttl_secs = 60
open_interest_ttl_secs = 30
slug_resolution_ttl_secs = 3600

# Override defaults from Polymarket docs if needed
# https://docs.polymarket.com/api-reference/rate-limits

# [rate_limits.gamma]
# events = { max_requests = 500, window_secs = 10 }

# [rate_limits.clob]
# book = { max_requests = 1500, window_secs = 10 }
# fee_rate = { max_requests = 200, window_secs = 10 }

# [rate_limits.data_api]
# general = { max_requests = 1000, window_secs = 10 }
# holders = { max_requests = 150, window_secs = 10 }
